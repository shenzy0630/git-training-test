# ========== 版本控制 ==========
.git/
.gitignore
.gitattributes

# ========== Python 运行时产物 ==========
__pycache__/
*.py[cod]
*.so
*.egg-info/

# ========== 虚拟环境 ==========
venv/
env/
.venv/
.env/

# ========== 测试产物 ==========
.pytest_cache/
.coverage
htmlcov/
.tox/

# ========== IDE 配置 ==========
.vscode/
.idea/
*.swp
*.swo

# ========== 构建/输出产物 ==========
build/
dist/
output/
*.log

# ========== 图片资源（除了必要样例）==========
*.jpg
*.jpeg
*.png
*.bmp
!examples/sample.jpg
!docs/**/*.png

# ========== Docker 文件自身 ==========
Dockerfile*
docker-compose*.yml
.dockerignore

